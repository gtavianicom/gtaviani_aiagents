<Files "blog-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<Files "blog-config.sample.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<Files "blog-template.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<Files "mcp-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# GTA-SEC-001 (2026-08-04) — blog-data/ (contiene blog.sqlite: password
# hash admin_users + TUTTI gli articoli inclusi i draft) e mcp-sessions/
# risultavano raggiungibili via HTTP senza nessuna protezione — i blocchi
# sopra proteggono solo file per nome, non un'intera sottocartella.
# Scoperto perché blog.sqlite era scaricabile direttamente, senza auth.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # GTA-BLOG-016 (2026-08-05) — questo blocco RewriteEngine ha
    # involontariamente reso INATTIVA, per tutto ciò che sta sotto /api/, la
    # regola equivalente nel .htaccess di root (GTA-BLOG-001, 2026-07-30) che
    # passa l'header Authorization a PHP su questo hosting — un
    # sotto-.htaccess con un proprio RewriteEngine On non eredita
    # automaticamente le regole del genitore (serve RewriteOptions Inherit,
    # mai impostato). Effetto: blog.php E mcp.php rispondevano 401 "Token
    # mancante o non valido" anche con token corretto, dal 4/8 in poi.
    # Duplicata qui invece di aggiungere RewriteOptions Inherit — esplicito e
    # autosufficiente, non dipende da sottigliezze di ereditarietà tra
    # Apache/versioni diverse.
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    RewriteRule ^blog-data/ - [F,L]
    RewriteRule ^mcp-sessions/ - [F,L]
</IfModule>
