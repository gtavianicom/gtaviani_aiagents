<Files "blog-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<Files "blog-config.sample.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<Files "blog-template.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<Files "mcp-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# GTA-SEC-001 (2026-08-04) — blog-data/ (contiene blog.sqlite: password
# hash admin_users + TUTTI gli articoli inclusi i draft) e mcp-sessions/
# risultavano raggiungibili via HTTP senza nessuna protezione — i blocchi
# sopra proteggono solo file per nome, non un'intera sottocartella.
# Scoperto perché blog.sqlite era scaricabile direttamente, senza auth.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^blog-data/ - [F,L]
    RewriteRule ^mcp-sessions/ - [F,L]
</IfModule>
